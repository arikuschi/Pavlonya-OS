#!/usr/bin/bash
# COSMIC-Sitzung erst starten, wenn der Anmeldebildschirm abgemeldet ist (25.10.2026).
#
# Sonst greift die neue Sitzung manchmal auf die AMD-Grafik (Laptop-Display) zu,
# solange die Sitzung des Anmeldebildschirms sie noch hält: „Failed to add device
# /dev/dri/card1“, das Laptop-Display bleibt dunkel und die Sitzung läuft nur auf
# dem 4K-Monitor (am Laptop gemessen: 2 ms zu früh). Wartet, bis logind keine
# Sitzung der Klasse „greeter“ mehr kennt — meist Millisekunden, höchstens 3 s.
# Aufgerufen aus /usr/share/wayland-sessions/cosmic.desktop (gesetzt beim Bau).
#
# Am 25.10.2026 zurückgenommen, am 30.10.2026 belegt und wieder eingebaut: Der
# Wettlauf steckt in greetd/COSMIC. Ohne „quiet“ schreibt der Kernel bei der
# Anmeldung Audit-Meldungen auf die Konsole; das bremste die Abmeldung des
# Anmeldebildschirms um ~0,5 s und verdeckte ihn bis zum Startbild (rhgb quiet).
# Gemessen über 80 Starts, Gegenprobe ohne „quiet“ am Laptop.

anmeldebildschirm_da() {
    local s
    for s in $(loginctl list-sessions --no-legend 2> /dev/null | awk '{print $1}'); do
        [[ "$(loginctl show-session "${s}" -p Class --value 2> /dev/null)" == greeter ]] && return 0
    done
    return 1
}

for _ in $(seq 30); do
    anmeldebildschirm_da || break
    sleep 0.1
done
exec /usr/bin/start-cosmic "$@"
