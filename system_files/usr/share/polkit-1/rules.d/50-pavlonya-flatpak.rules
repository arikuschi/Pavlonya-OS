// Flatpaks installieren und aktualisieren ohne Kennwortabfrage für Administratoren
// (Gruppe wheel), die lokal und aktiv angemeldet sind. Ohne diese Regel fragt der
// COSMIC Store bei jeder Aktualisierung nach dem Kennwort, weil die Flatpaks
// systemweit installiert sind (VM-Test 11.10.2026).
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.Flatpak.") == 0 &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
