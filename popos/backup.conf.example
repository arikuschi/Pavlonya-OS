# Pop!_OS — Backup mit restic. Liegt als /etc/popos-backup/backup.conf (root, 600).
# Diese Datei steht im Repo nur als Vorlage, ohne Adresse und Kennwort.

# NFS-Freigabe der TrueNAS und wo sie eingehängt wird (wie in /etc/fstab)
NFS_QUELLE="<truenas-ip>:/mnt/pavlonya-data/backups/linux"
EINHAENGEPUNKT="/mnt/truenas-backup"
REPO_UNTERORDNER="restic"

# Kennwort des Repositorys (eine Zeile), root, chmod 600
PASSWORT_DATEI="/etc/popos-backup/restic-passwort"

HOST="pop-os"
BENUTZER="arikushi"

# Was gesichert wird (ganzes Home ohne Neuladbares, dazu die nötigen Systemteile),
# steht im Skript popos-backup. Hier nur, was zusätzlich dazukommen bzw. wegbleiben soll:
SYSTEM_PFADE=()
AUSSCHLUESSE=()

# Pakete, die nicht in die Programmliste kommen (13.10.2026)
PAKETE_AUSSCHLIESSEN=( grub-pc-bin grub2-common )

BEHALTEN=( --keep-daily 7 --keep-weekly 4 )
