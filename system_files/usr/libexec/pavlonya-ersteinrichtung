#!/usr/bin/bash
# Ersteinrichtung nach der Anmeldung — mit Fortschrittsfenster.
#
# 1. Programme (Flatpaks): installiert pavlonya-flatpaks.service im Hintergrund;
#    hier wird nur der Fortschritt angezeigt.
# 2. Distroboxen (Claude Desktop, Entwicklung) anlegen.
# 3. Abschlussmeldung.
#
# Läuft bei jeder Anmeldung, bis alles fertig ist; danach nie wieder
# (Merker unter ~/.local/state/pavlonya-os). Wunsch Sergej, 12.10.2026: beim
# ersten Start sehen, was passiert und wann es fertig ist.
set -u

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/pavlonya-os"
DONE="${STATE}/ersteinrichtung-fertig"
LOG="${STATE}/ersteinrichtung.log"
LIST=/usr/share/pavlonya-os/flatpaks.txt
BOXES=/usr/share/pavlonya-os/distrobox.ini
TITLE="Pavlonya OS – Ersteinrichtung"

mkdir -p "${STATE}"

box_exists() {
    podman container exists "$1" 2> /dev/null
}

chatgpt_exported() {
    [[ -e "${HOME}/.local/share/applications/claude-chatgpt.desktop" ]]
}

claude_code_da() {
    [[ -x "${HOME}/.local/bin/claude" ]]
}

# --- bei jeder Anmeldung: schnell, überschreibt nichts -------------------------
# Flatpak-Quellen auch für den Benutzer: der COSMIC Store zeigt sonst „Bitte
# aktiviere Flathub und COSMIC Flatpak“ (Laptop 12.10.2026).
flatpak remote-add --user --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo > /dev/null 2>&1 || true
flatpak remote-add --user --if-not-exists cosmic \
    https://apt.pop-os.org/cosmic/cosmic.flatpakrepo > /dev/null 2>&1 || true

# Minimon wie unter Pop!_OS — nur wenn der Benutzer noch keine eigene Einstellung hat
MINIMON="${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/io.github.cosmic_utils.minimon-applet-panel/v1"
if [[ ! -d "${MINIMON}" ]]; then
    mkdir -p "${MINIMON}"
    cp /usr/share/pavlonya-os/minimon/* "${MINIMON}/"
fi

# Aussehen wie Pop!_OS (Leiste, Dock, Farbschema) EINMAL aktiv übernehmen.
# Systemvorgaben unter /usr/share/cosmic gelten nur für Werte, die der Benutzer
# noch nicht hat — COSMIC legt aber beim ersten Anmelden eigene an (Laptop
# 13.10.2026: Vorgabe griff nicht). Danach frei änderbar; neue Fassung = neuer Merker.
AUSSEHEN_MERKER="${STATE}/aussehen-popos-v1"
if [[ ! -e "${AUSSEHEN_MERKER}" ]]; then
    for d in com.system76.CosmicPanel.Panel com.system76.CosmicPanel.Dock \
             com.system76.CosmicTheme.Dark com.system76.CosmicTheme.Dark.Builder \
             com.system76.CosmicTheme.Light com.system76.CosmicTheme.Light.Builder \
             com.system76.CosmicTheme.Mode com.system76.CosmicTk com.system76.CosmicAppList; do
        [[ -d "/usr/share/cosmic/${d}/v1" ]] || continue
        mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/${d}/v1"
        cp -f "/usr/share/cosmic/${d}/v1/"* "${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/${d}/v1/"
    done
    touch "${AUSSEHEN_MERKER}"
fi

# Backup-Hinweis: warnen, wenn eingerichtet, aber fehlgeschlagen oder zu alt
if [[ -r /var/lib/pavlonya-os/backup-status ]]; then
    # shellcheck disable=SC1091
    source /var/lib/pavlonya-os/backup-status
    alter=$(( ( $(date +%s) - ${ZEIT:-0} ) / 86400 ))
    if [[ "${ERGEBNIS:-}" != ok ]]; then
        zenity --warning --title="Pavlonya OS – Backup" --width=460 \
            --text="Das letzte Backup ist fehlgeschlagen:\n\n${TEXT:-unbekannt}" &
    elif (( alter >= 3 )); then
        zenity --warning --title="Pavlonya OS – Backup" --width=460 \
            --text="Das letzte erfolgreiche Backup ist ${alter} Tage alt.\nIst der Laptop im Heimnetz?" &
    fi
fi

# Später ins Image gekommene Box-Programme (ChatGPT, 12.10.2026) nachholen
if box_exists claude && ! chatgpt_exported; then
    rm -f "${DONE}"
fi
# Claude Code im Terminal (13.10.2026)
if ! claude_code_da; then
    rm -f "${DONE}"
fi

[[ -e "${DONE}" ]] && exit 0

# App-IDs aus der Liste (Zeile = „<id>“ oder „<quelle> <id>“)
mapfile -t APPS < <(sed -E 's/#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//; /^$/d' "${LIST}" | awk '{print $NF}')
TOTAL=${#APPS[@]}

installed_count() {
    local n=0 a
    for a in "${APPS[@]}"; do
        flatpak info --system "${a}" > /dev/null 2>&1 && n=$((n + 1))
    done
    echo "${n}"
}

first_missing() {
    local a
    for a in "${APPS[@]}"; do
        flatpak info --system "${a}" > /dev/null 2>&1 || { echo "${a##*.}"; return; }
    done
}

progress() {
    # --- 1. Programme ---------------------------------------------------------
    while :; do
        n=$(installed_count)
        echo $(( n * 70 / TOTAL ))
        if (( n >= TOTAL )); then
            echo "# Programme: alle ${TOTAL} installiert"
            break
        fi
        if ! nm-online -q -t 2; then
            echo "# Warte auf Internetverbindung … (Programme: ${n} von ${TOTAL})"
        elif [[ "$(systemctl is-active pavlonya-flatpaks.service)" == "activating" ]]; then
            cur=$(first_missing)
            echo "# Programme werden installiert: ${n} von ${TOTAL}${cur:+ — gerade: ${cur}}"
        else
            # Dienst ist durch, aber es fehlt etwas: er versucht es alle 5 Minuten erneut
            echo "# Programme: ${n} von ${TOTAL} — Rest folgt automatisch, weiter mit Schritt 2"
            sleep 3
            break
        fi
        sleep 3
    done

    # --- 2. Distroboxen -------------------------------------------------------
    if box_exists claude && box_exists dev; then
        echo 80
        echo "# Claude Desktop und Entwicklungs-Box sind schon eingerichtet"
    else
        echo 72
        echo "# Claude Desktop und ChatGPT werden eingerichtet (Ubuntu-Box) — dauert einige Minuten …"
        distrobox assemble create --file "${BOXES}" 2>&1 | while read -r line; do
            echo "${line}" >> "${LOG}"
            case "${line}" in
                *"Creating dev"*)
                    echo 88
                    echo "# Entwicklungs-Box wird eingerichtet (Compiler, Python) …" ;;
            esac
        done
    fi

    # ChatGPT in einer schon vorhandenen Box nachinstallieren
    if box_exists claude && ! chatgpt_exported; then
        echo 92
        echo "# ChatGPT wird in der Ubuntu-Box nachinstalliert …"
        hook="$(sed -nE 's/^init_hooks="(command -v chatgpt.*)"$/\1/p' "${BOXES}")"
        {
            distrobox enter claude -- sudo -n sh -c "${hook}"
            distrobox enter claude -- distrobox-export --app chatgpt
        } >> "${LOG}" 2>&1
    fi

    # --- 3. Claude Code (Terminal) --------------------------------------------
    # Offizieller Installer von Anthropic, installiert nach ~/.local/bin und
    # aktualisiert sich danach selbst — wie unter Pop!_OS.
    if ! claude_code_da; then
        echo 96
        echo "# Claude Code (Terminal) wird installiert …"
        curl -fsSL https://claude.ai/install.sh | bash >> "${LOG}" 2>&1
    fi
    echo 100
    echo "# Fertig"
}

progress | zenity --progress --title="${TITLE}" --width=520 \
    --text="Ersteinrichtung startet …" --percentage=0 --auto-close --no-cancel

# --- 3. Ergebnis --------------------------------------------------------------
n=$(installed_count)
ok=1
msg="Programme: ${n} von ${TOTAL} installiert."
if (( n < TOTAL )); then
    ok=0
    msg+="\nFehlende werden automatisch nachgeholt (alle 5 Minuten)."
fi
if box_exists claude; then
    msg+="\nClaude Desktop: eingerichtet — im Startmenü unter „Claude (on claude)“."
else
    ok=0
    msg+="\nClaude Desktop: nicht eingerichtet — Protokoll: ${LOG}"
fi
if chatgpt_exported; then
    msg+="\nChatGPT: eingerichtet — im Startmenü unter „ChatGPT (on claude)“."
else
    ok=0
    msg+="\nChatGPT: nicht eingerichtet — Protokoll: ${LOG}"
fi
if claude_code_da; then
    msg+="\nClaude Code: eingerichtet — im Terminal mit „claude“ starten."
else
    ok=0
    msg+="\nClaude Code: nicht eingerichtet — Protokoll: ${LOG}"
fi
if box_exists dev; then
    msg+="\nEntwicklungs-Box: eingerichtet — im Startmenü unter „Dev“."
else
    ok=0
fi

if (( ok )); then
    touch "${DONE}"
    zenity --info --title="${TITLE}" --width=480 \
        --text="Alles eingerichtet.\n\n${msg}"
else
    zenity --warning --title="${TITLE}" --width=480 \
        --text="Noch nicht alles fertig.\n\n${msg}\n\nBeim nächsten Anmelden geht es weiter."
fi
