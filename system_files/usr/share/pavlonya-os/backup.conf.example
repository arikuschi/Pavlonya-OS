# Pavlonya OS — Backup mit restic. Kopie nach /etc/pavlonya-os/backup.conf
# (root, chmod 600). Diese Datei steht NICHT im Repo und nicht im Image.

# NFS-Freigabe der TrueNAS (Adresse aus dem Vault, Notiz „Homelab Pavlonya")
NFS_QUELLE="<truenas-ip>:/mnt/pavlonya-data/backups/linux"

# restic-Repository relativ zur eingehängten Freigabe (dasselbe wie unter Pop!_OS)
REPO_UNTERORDNER="restic"

# Kennwort des Repositorys (eine Zeile), root-only: chmod 600
PASSWORT_DATEI="/etc/pavlonya-os/restic-passwort"

# Rechnername in den Sicherungen — trennt sie von denen aus Pop!_OS
HOST="pavlonya-os"

# Benutzer, dessen Home gesichert wird
BENUTZER="arikushi"

# Was gesichert wird, steht im Image: /usr/share/pavlonya-os/sicherung.sh (03.11.2026).
# HOME_PFADE, SYSTEM_PFADE und AUSSCHLUESSE in dieser Datei gelten nicht mehr.

# Aufbewahrung (nur Sicherungen dieses Rechners)
BEHALTEN=( --keep-daily 7 --keep-weekly 4 )
