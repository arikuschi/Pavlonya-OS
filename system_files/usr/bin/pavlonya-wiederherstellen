#!/usr/bin/bash
# pavlonya-wiederherstellen — Gerätedaten nach einer Neuinstallation aus dem
# restic-Backup auf der TrueNAS zurückholen (13.10.2026).
#
# Holt aus der letzten Sicherung:
#   - VPN-Verbindungen     /etc/NetworkManager/system-connections/
#   - Backup-Einstellungen /etc/pavlonya-os/ (backup.conf, restic-passwort)
#   - SSH-Schlüssel        ~/.ssh
#   - Storage Box          sshfs-Zeilen aus /etc/fstab, SSH-Dateien von root
#   - Cryptomator          Tresorliste, wenn hier noch keiner eingetragen ist
# Vorhandene Dateien werden NICHT überschrieben.
#
# Danach auf Wunsch: Programm-Einstellungen aus der letzten Pop!_OS-Sicherung —
# nur die Programme aus PROGRAMM_EINSTELLUNGEN unten, ohne Schlüsselbund. Diese
# werden ÜBERSCHRIEBEN; die Programme müssen dafür geschlossen sein.
#
# Aufruf:  sudo pavlonya-wiederherstellen [--host pavlonya-os|pop-os]
# Fragt nach der TrueNAS-Adresse (Vault: „Homelab Pavlonya") und dem
# restic-Kennwort (Bitwarden).
set -uo pipefail

NFS_PFAD="/mnt/pavlonya-data/backups/linux"
REPO_UNTERORDNER="restic"
MNT=/var/mnt/pavlonya-wiederherstellen
CONF_DIR=/etc/pavlonya-os
NM_DIR=/etc/NetworkManager/system-connections
WUNSCH_HOST=""

[[ "${1:-}" == "--host" ]] && WUNSCH_HOST="${2:-}"

if [[ ${EUID} -ne 0 ]]; then
    echo "Bitte mit sudo starten:  sudo pavlonya-wiederherstellen"
    exit 1
fi

BENUTZER="${SUDO_USER:-}"
if [[ -z "${BENUTZER}" || "${BENUTZER}" == root ]]; then
    read -rp "Für welchen Benutzer (z. B. arikushi)? " BENUTZER
fi
HOMEDIR="$(getent passwd "${BENUTZER}" | cut -d: -f6)"
[[ -n "${HOMEDIR}" ]] || { echo "Benutzer ${BENUTZER} gibt es nicht."; exit 1; }

echo "=== Pavlonya OS — Gerätedaten wiederherstellen (Benutzer ${BENUTZER}) ==="
read -rp "TrueNAS-Adresse (IP, steht im Vault unter „Homelab Pavlonya“): " NAS
read -rsp "restic-Kennwort (Bitwarden): " PASSWORT; echo
read -rp "Auch Programm-Einstellungen aus Pop!_OS übernehmen (Browser, Thunderbird, Obsidian, WinBox, RustDesk …)? [J/n] " PROGRAMME

GID="$(id -g "${BENUTZER}")"
ARBEIT="$(mktemp -d /var/tmp/pavlonya-wiederherstellen.XXXX)"
chown "${BENUTZER}:${GID}" "${ARBEIT}"; chmod 700 "${ARBEIT}"
printf '%s\n' "${PASSWORT}" > "${ARBEIT}/pw"; chown "${BENUTZER}" "${ARBEIT}/pw"; chmod 600 "${ARBEIT}/pw"
EINGEHAENGT=0
aufraeumen() {
    [[ ${EINGEHAENGT} == 1 ]] && umount "${MNT}"
    rm -rf "${ARBEIT}"
}
trap aufraeumen EXIT

mkdir -p "${MNT}"
if ! mountpoint -q "${MNT}"; then
    # nicht schreibgeschützt: restic legt auch beim Lesen eine Sperrdatei an
    # (Laptop 14.10.2026: „read-only file system“ bei locks/)
    mount -t nfs -o soft,timeo=150,retrans=3 "${NAS}:${NFS_PFAD}" "${MNT}" \
        || { echo "TrueNAS ${NAS} nicht erreichbar — im Heimnetz?"; exit 1; }
    EINGEHAENGT=1
fi
# restic als Repo-Besitzer (root hätte auf der NFS-Freigabe evtl. keinen Zugriff);
# die Dateien landen im Arbeitsordner und werden dann von root an ihren Platz gelegt
restic() {
    setpriv --reuid="${BENUTZER}" --regid="${GID}" --init-groups \
        env HOME="${HOMEDIR}" RESTIC_CACHE_DIR="${HOMEDIR}/.cache/restic" \
        RESTIC_REPOSITORY="${MNT}/${REPO_UNTERORDNER}" RESTIC_PASSWORD_FILE="${ARBEIT}/pw" \
        /usr/bin/restic "$@"
}

# Welche Sicherung? Bevorzugt die eigene, sonst die von Pop!_OS.
hat_snapshot() { restic snapshots --host "$1" --latest 1 --json 2> /dev/null | grep -q '"id"'; }
if ! restic cat config > "${ARBEIT}/check.log" 2>&1; then
    echo "Repository nicht lesbar. Meldung von restic:"
    grep -v '^\s*$' "${ARBEIT}/check.log" | tail -3 | sed 's/^/   /'
    echo "(„wrong password“ = Kennwort falsch; „permission denied“ = Zugriffsrecht auf der TrueNAS)"
    exit 1
fi
if [[ -n "${WUNSCH_HOST}" ]]; then
    HOST="${WUNSCH_HOST}"
elif hat_snapshot pavlonya-os; then
    HOST=pavlonya-os
elif hat_snapshot pop-os; then
    HOST=pop-os
else
    echo "Keine Sicherung von pavlonya-os oder pop-os gefunden."
    exit 1
fi
echo "Hole aus der letzten Sicherung von „${HOST}“ …"

# Home liegt unter Pop!_OS in /home, unter Pavlonya OS in /var/home
INCL=( --include "${NM_DIR}" --include "${CONF_DIR}" --include /run/NetworkManager/system-connections
       --include /etc/fstab --include /root/.ssh --include /var/roothome/.ssh )
for h in "/home/${BENUTZER}" "/var/home/${BENUTZER}"; do
    INCL+=( --include "${h}/.ssh" )
done
restic restore latest --host "${HOST}" --target "${ARBEIT}/r" "${INCL[@]}" \
    > "${ARBEIT}/restore.log" 2>&1 \
    || { echo "Wiederherstellen fehlgeschlagen:"; tail -5 "${ARBEIT}/restore.log"; exit 1; }

ERGEBNIS=()

# --- VPN-Verbindungen ---------------------------------------------------------
n=0
if [[ -d "${ARBEIT}/r${NM_DIR}" ]]; then
    for f in "${ARBEIT}/r${NM_DIR}"/*.nmconnection; do
        [[ -e "${f}" ]] || continue
        ziel="${NM_DIR}/$(basename "${f}")"
        if [[ ! -e "${ziel}" ]]; then
            install -m600 -o root -g root "${f}" "${ziel}"
            n=$((n + 1))
        fi
    done
    true
fi
# Aus einer Pop!_OS-Sicherung: von netplan erzeugte Dateien — nur VPN und WLAN,
# Dateiname nach dem Verbindungsnamen (id=)
if [[ -d "${ARBEIT}/r/run/NetworkManager/system-connections" ]]; then
    for f in "${ARBEIT}/r/run/NetworkManager/system-connections"/*.nmconnection; do
        [[ -e "${f}" ]] || continue
        typ="$(sed -n 's/^type=//p' "${f}" | head -1)"
        [[ "${typ}" =~ ^(wireguard|vpn|wifi|802-11-wireless)$ ]] || continue
        name="$(sed -n 's/^id=//p' "${f}" | head -1)"
        name="${name//[^A-Za-z0-9._-]/_}"
        ziel="${NM_DIR}/${name:-$(basename "${f}" .nmconnection)}.nmconnection"
        if [[ ! -e "${ziel}" ]]; then
            install -m600 -o root -g root "${f}" "${ziel}"
            n=$((n + 1))
        fi
    done
fi
if (( n > 0 )); then
    command -v restorecon > /dev/null && restorecon -R "${NM_DIR}"
    command -v nmcli > /dev/null && nmcli connection reload
fi
ERGEBNIS+=("VPN-/Netzwerkverbindungen: ${n} übernommen")

# --- Backup-Einstellungen -----------------------------------------------------
mkdir -p "${CONF_DIR}"
if [[ -e "${CONF_DIR}/backup.conf" ]]; then
    ERGEBNIS+=("Backup-Einstellungen: schon vorhanden, unverändert")
elif [[ -e "${ARBEIT}/r${CONF_DIR}/backup.conf" ]]; then
    install -m600 "${ARBEIT}/r${CONF_DIR}/backup.conf" "${CONF_DIR}/backup.conf"
    ERGEBNIS+=("Backup-Einstellungen: aus der Sicherung übernommen")
else
    install -m600 /usr/share/pavlonya-os/backup.conf.example "${CONF_DIR}/backup.conf"
    sed -i "s|<truenas-ip>|${NAS}|; s|^BENUTZER=.*|BENUTZER=\"${BENUTZER}\"|" "${CONF_DIR}/backup.conf"
    ERGEBNIS+=("Backup-Einstellungen: neu aus der Vorlage (TrueNAS ${NAS})")
fi
if [[ ! -e "${CONF_DIR}/restic-passwort" ]]; then
    install -m600 "${ARBEIT}/pw" "${CONF_DIR}/restic-passwort"
fi
command -v restorecon > /dev/null && restorecon -R "${CONF_DIR}"

# --- SSH-Schlüssel ------------------------------------------------------------
n=0
for h in "/var/home/${BENUTZER}" "/home/${BENUTZER}"; do
    quelle="${ARBEIT}/r${h}/.ssh"
    [[ -d "${quelle}" ]] || continue
    install -d -m700 -o "${BENUTZER}" -g "${BENUTZER}" "${HOMEDIR}/.ssh"
    for f in "${quelle}"/*; do
        [[ -e "${f}" ]] || continue
        ziel="${HOMEDIR}/.ssh/$(basename "${f}")"
        if [[ ! -e "${ziel}" ]]; then
            cp -a "${f}" "${ziel}"
            chown "${BENUTZER}:${BENUTZER}" "${ziel}"
            n=$((n + 1))
        fi
    done
    break
done
command -v restorecon > /dev/null && [[ -d "${HOMEDIR}/.ssh" ]] && restorecon -R "${HOMEDIR}/.ssh"
ERGEBNIS+=("SSH-Dateien: ${n} übernommen")

# --- Storage Box (sshfs) -------------------------------------------------------
# Unter Pop!_OS hängt root sie per /etc/fstab ein (fuse.sshfs, Schlüssel in
# /root/.ssh). Übernommen werden die sshfs-Zeilen der gesicherten fstab und die
# SSH-Dateien von root — Adresse und Schlüssel stehen nur in der Sicherung, nie
# im Repo. /mnt ist unter Pavlonya OS ein Verweis auf /var/mnt; systemd und
# Flatpak brauchen den echten Pfad (30.10.2026).
n=0
for quelle in "${ARBEIT}/r/var/roothome/.ssh" "${ARBEIT}/r/root/.ssh"; do
    [[ -d "${quelle}" ]] || continue
    install -d -m700 /root/.ssh
    for f in "${quelle}"/*; do
        [[ -e "${f}" ]] || continue
        ziel="/root/.ssh/$(basename "${f}")"
        if [[ ! -e "${ziel}" ]]; then
            cp -a "${f}" "${ziel}"
            chown root:root "${ziel}"
            n=$((n + 1))
        fi
    done
    break
done
command -v restorecon > /dev/null && [[ -d /root/.ssh ]] && restorecon -R /root/.ssh
SSHFS_ZIELE=(); neu=()
if [[ -f "${ARBEIT}/r/etc/fstab" ]]; then
    while read -r quelle ziel typ optionen rest; do
        [[ "${quelle}" == \#* || "${typ:-}" != fuse.sshfs ]] && continue
        [[ "${ziel}" == /mnt/* ]] && ziel="/var${ziel}"
        SSHFS_ZIELE+=("${ziel}")
        awk -v z="${ziel}" '$2 == z { gefunden = 1 } END { exit !gefunden }' /etc/fstab && continue
        mkdir -p "${ziel}"
        printf '%s %s %s %s %s\n' "${quelle}" "${ziel}" "${typ}" "${optionen}" "${rest:-0 0}" >> /etc/fstab
        neu+=("${ziel}")
    done < "${ARBEIT}/r/etc/fstab"
fi
if (( ${#neu[@]} > 0 )); then
    systemctl daemon-reload
    for z in "${neu[@]}"; do
        if timeout 30 mount "${z}" 2>> "${ARBEIT}/mount.log"; then
            ERGEBNIS+=("Storage Box: ${z} eingetragen und eingehängt")
        else
            ERGEBNIS+=("Storage Box: ${z} eingetragen, Einhängen fehlgeschlagen: $(tail -1 "${ARBEIT}/mount.log")")
        fi
    done
elif (( ${#SSHFS_ZIELE[@]} > 0 )); then
    ERGEBNIS+=("Storage Box: schon in /etc/fstab, unverändert")
fi
ERGEBNIS+=("   SSH-Dateien von root: ${n} übernommen")
# Cryptomator (Flatpak) braucht Zugriff auf den Einhängepunkt
for z in "${SSHFS_ZIELE[@]}"; do
    flatpak override --system org.cryptomator.Cryptomator --filesystem="${z}" 2> /dev/null || true
done

# --- Cryptomator ----------------------------------------------------------------
# Die Tresorliste liegt unter ~/.config/Cryptomator, nicht unter ~/.var/app.
# Übernommen nur, wenn hier noch kein Tresor eingetragen ist; Pfade /mnt/… werden
# zu /var/mnt/…. Das Tresor-Kennwort liegt im Pop!_OS-Schlüsselbund und kommt
# nicht mit: beim ersten Entsperren einmal eingeben und speichern (30.10.2026).
CRYPTO="${HOMEDIR}/.config/Cryptomator/settings.json"
if [[ -f "${CRYPTO}" ]] && grep -q '"path"' "${CRYPTO}"; then
    ERGEBNIS+=("Cryptomator: Tresore schon eingetragen, unverändert")
elif hat_snapshot pop-os && restic restore "latest:/home/${BENUTZER}/.config/Cryptomator" --host pop-os \
        --target "${ARBEIT}/cryptomator" >> "${ARBEIT}/programme.log" 2>&1 \
        && [[ -f "${ARBEIT}/cryptomator/settings.json" ]]; then
    while pgrep -u "${BENUTZER}" -f org.cryptomator > /dev/null; do
        read -rp "Cryptomator läuft — bitte schließen, dann Enter … " _
    done
    install -d -m755 -o "${BENUTZER}" -g "${GID}" "${HOMEDIR}/.config/Cryptomator"
    sed 's#"/mnt/#"/var/mnt/#g' "${ARBEIT}/cryptomator/settings.json" > "${CRYPTO}"
    chown "${BENUTZER}:${GID}" "${CRYPTO}"; chmod 644 "${CRYPTO}"
    command -v restorecon > /dev/null && restorecon -R "${HOMEDIR}/.config/Cryptomator"
    ERGEBNIS+=("Cryptomator: Tresorliste aus Pop!_OS übernommen — Tresor-Kennwort einmal neu eingeben")
else
    ERGEBNIS+=("Cryptomator: keine Einstellungen in der Pop!_OS-Sicherung")
fi

# --- Programm-Einstellungen aus Pop!_OS ----------------------------------------
# Nur, was ohne den Pop!_OS-Schlüsselbund funktioniert (19.10.2026: saubere
# Distro, Schlüsselbund nicht übertragen). Tabby wieder dabei (21.10.2026): die
# leeren Flächen und Abstürze kamen nicht von seinen Einstellungen, sondern vom
# fontconfig-Cache, den die Ubuntu-Box überschrieb. Im Schlüsselbund gespeicherte
# SSH-Kennwörter fragt Tabby einmal neu ab.
# RustDesk fragt danach je Gegenstelle einmal deren Kennwort ab — die gespeicherten
# hängen an der Geräte-ID; sonst funktioniert es (19.10.2026).
# Zeile: <Pfad unter ~>|<Ausschluss>|… — Ausschlüsse mit „/“ vorn gelten ab diesem
# Pfad, ohne „/“ überall darunter.
#   Zwischenspeicher (cache, .ld.so, Cache-Ordner) braucht niemand.
#   keyrings = Kennwortspeicher der Flatpaks, verschlüsselt mit einem Schlüssel aus
#   dem Pop!_OS-Schlüsselbund — unbrauchbar ohne ihn.
#   Chrome/Chromium/Obsidian verschlüsseln Cookies und Kennwörter ebenfalls mit dem
#   Schlüsselbund: die bleiben weg, Lesezeichen, Erweiterungen, Verlauf kommen mit.
#   Floorp und Thunderbird haben einen eigenen Kennwortspeicher (key4.db): komplett.
FLATPAK_RAUS="/cache|/.ld.so|keyrings"
CHROMIUM_RAUS="Cookies*|Login Data*|Cache|Code Cache|GPUCache|DawnGraphiteCache|DawnWebGPUCache"
PROGRAMM_EINSTELLUNGEN=(
    ".var/app/one.ablaze.floorp|${FLATPAK_RAUS}"
    ".var/app/com.google.Chrome|${FLATPAK_RAUS}|${CHROMIUM_RAUS}"
    ".var/app/org.chromium.Chromium|${FLATPAK_RAUS}|${CHROMIUM_RAUS}"
    ".var/app/org.mozilla.thunderbird|${FLATPAK_RAUS}"
    ".var/app/md.obsidian.Obsidian|${FLATPAK_RAUS}|${CHROMIUM_RAUS}"
    ".var/app/com.mikrotik.WinBox|${FLATPAK_RAUS}"
    ".var/app/org.remmina.Remmina|${FLATPAK_RAUS}"
    ".var/app/com.rustdesk.RustDesk|${FLATPAK_RAUS}"
    ".var/app/com.bambulab.BambuStudio|${FLATPAK_RAUS}"
    ".var/app/dev.zed.Zed/config/zed"
    ".vscode/extensions"
    ".config/tabby|${CHROMIUM_RAUS}"
)

# Quelle ist immer die letzte Pop!_OS-Sicherung (dort liegt das Home unter /home).
# restic läuft als Benutzer und schreibt direkt ins Home — Dateien gehören ihm.
if [[ "${PROGRAMME,,}" != n* ]]; then
    if hat_snapshot pop-os; then
        echo
        echo "Programm-Einstellungen aus Pop!_OS werden übernommen. Bitte diese Programme"
        echo "schließen: Floorp, Chrome, Chromium, Thunderbird, Obsidian, WinBox, Remmina,"
        echo "RustDesk, Bambu Studio, Zed, VS Code, Tabby."
        read -rp "Weiter mit Enter … " _
        ok=(); fehl=()
        for eintrag in "${PROGRAMM_EINSTELLUNGEN[@]}"; do
            IFS='|' read -ra teile <<< "${eintrag}"
            rel="${teile[0]}"
            EXCL=()
            for e in "${teile[@]:1}"; do EXCL+=(--exclude "${e}"); done
            if restic restore "latest:/home/${BENUTZER}/${rel}" --host pop-os \
                    --target "${HOMEDIR}/${rel}" "${EXCL[@]}" >> "${ARBEIT}/programme.log" 2>&1; then
                ok+=("${rel##*/}")
            else
                fehl+=("${rel##*/}")
            fi
        done
        # Obsidian-Vaults kommen NICHT mit — die folgen mit allen Dokumenten beim
        # Umzug (14.10.2026); hier nur die Obsidian-Programmeinstellungen.
        command -v restorecon > /dev/null && restorecon -R "${HOMEDIR}" 2> /dev/null
        ERGEBNIS+=("Programm-Einstellungen aus Pop!_OS: ${#ok[@]} übernommen (${ok[*]})")
        (( ${#fehl[@]} > 0 )) && ERGEBNIS+=("   nicht in der Sicherung: ${fehl[*]}")
    else
        ERGEBNIS+=("Programm-Einstellungen: keine Pop!_OS-Sicherung gefunden")
    fi
fi

echo
echo "=== Ergebnis (Quelle: ${HOST}) ==="
printf ' - %s\n' "${ERGEBNIS[@]}"
echo
echo "Backup jetzt einmal testen:  sudo systemctl start pavlonya-backup && cat /var/lib/pavlonya-os/backup-status"
