// Flatpaks installieren, aktualisieren und entfernen ohne Kennwortabfrage für
// Administratoren (Gruppe wheel), die lokal und aktiv angemeldet sind. Ohne diese
// Regel fragt der COSMIC Store bei jeder Aktualisierung nach dem Kennwort, weil die
// Flatpaks systemweit installiert sind (VM-Test 11.10.2026).
//
// Nur diese Aktionen (23.10.2026): Paketquellen hinzufügen oder ändern
// (configure-remote, configure, modify-repo) und Jugendschutz-Ausnahmen fragen
// weiter nach dem Kennwort — sonst könnte jedes Programm, das unter dem Benutzer
// läuft, ohne Rückfrage eine fremde Quelle eintragen und daraus installieren.
var PAVLONYA_FLATPAK_OHNE_KENNWORT = [
    "org.freedesktop.Flatpak.app-install",
    "org.freedesktop.Flatpak.runtime-install",
    "org.freedesktop.Flatpak.app-update",
    "org.freedesktop.Flatpak.runtime-update",
    "org.freedesktop.Flatpak.app-uninstall",
    "org.freedesktop.Flatpak.runtime-uninstall",
    "org.freedesktop.Flatpak.update-remote",
    "org.freedesktop.Flatpak.appstream-update",
    "org.freedesktop.Flatpak.metadata-update"
];

polkit.addRule(function(action, subject) {
    if (PAVLONYA_FLATPAK_OHNE_KENNWORT.indexOf(action.id) >= 0 &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
