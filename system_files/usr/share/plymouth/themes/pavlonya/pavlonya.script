// Pavlonya OS — Startbild (Wunsch 24.10.2026): Logo mit Schriftzug in der Mitte,
// darunter ein Fortschrittsbalken in den Logo-Farben, schwarzer Hintergrund.
// Die Bilder rendert der Bau aus startbild/*.svg (doppelte Auflösung); alle Größen
// hängen an der Bildschirmhöhe, damit es am Laptop und am 4K-Monitor gleich wirkt.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

breite = Window.GetWidth();
hoehe = Window.GetHeight();

// Logo mit Schriftzug: 36 % der Bildschirmhöhe, etwas über der Mitte
bild = Image("startbild.png");
faktor = (hoehe * 0.36) / bild.GetHeight();
bild = bild.Scale(bild.GetWidth() * faktor, bild.GetHeight() * faktor);
logo = Sprite(bild);
logo.SetPosition(Window.GetX() + (breite - bild.GetWidth()) / 2,
                 Window.GetY() + (hoehe - bild.GetHeight()) / 2 - hoehe * 0.04, 1);

// Fortschrittsbalken: halb so breit wie der Schriftzug, mit Abstand darunter
balken_breite = Math.Int(bild.GetWidth() * 0.5);
balken_hoehe = Math.Int(hoehe * 0.008) + 2;
balken_x = Window.GetX() + (breite - balken_breite) / 2;
balken_y = logo.GetY() + bild.GetHeight() + hoehe * 0.05;

hinten = Sprite(Image("balken-hinten.png").Scale(balken_breite, balken_hoehe));
hinten.SetPosition(balken_x, balken_y, 2);

vorne_vorlage = Image("balken-vorne.png");
vorne = Sprite();
vorne.SetPosition(balken_x, balken_y, 3);

fun fortschritt(dauer, anteil) {
    fuellung = Math.Int(balken_breite * anteil);
    if (fuellung < 1) {
        fuellung = 1;
    }
    vorne.SetImage(vorne_vorlage.Scale(fuellung, balken_hoehe));
}
Plymouth.SetBootProgressFunction(fortschritt);
